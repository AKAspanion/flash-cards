# `npm run dev:emulator`: talks to the local emulators started by `npm run emulators`.
# Overrides .env.local; no real Firebase project is touched.
VUE_APP_USE_EMULATORS=true
VUE_APP_API_KEY=demo-key
VUE_APP_PROJECT_ID=demo-flash-cards
VUE_APP_AUTH_DOMAIN=localhost
VUE_APP_APP_ID=demo-app

# Throwaway account for manual testing against the Auth emulator only.
# E2E_EMAIL=tester@example.test
# E2E_PASSWORD=emulator-only-123
