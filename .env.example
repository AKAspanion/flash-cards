# Firebase web app config (Firebase console > Project settings > Your apps).
# Copy to .env.local and fill in; .env.local is gitignored.
VUE_APP_API_KEY=
VUE_APP_AUTH_DOMAIN=
VUE_APP_DATABASE_URL=
VUE_APP_PROJECT_ID=
VUE_APP_STORAGE_BUCKET=
VUE_APP_MESSAGING_SENDER_ID=
VUE_APP_APP_ID=
VUE_APP_MEASUREMENT_ID=

# Local development against emulators (npm run emulators) instead of the live project:
# VUE_APP_USE_EMULATORS=true
# VUE_APP_API_KEY=demo-key
# VUE_APP_PROJECT_ID=demo-flash-cards
