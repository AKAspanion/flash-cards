{
  "name": "flash-cards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "vue-tsc --noEmit && vite build",
    "build:e2e": "vite build --mode emulator --outDir dist-e2e",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools@15.34.2 emulators:exec --only firestore --project demo-flash-cards \"vitest run tests/unit/firestore.rules.spec.ts\"",
    "test:e2e": "pnpm run build:e2e && npx --yes firebase-tools@15.34.2 emulators:exec --only auth,firestore --project demo-flash-cards \"playwright test\"",
    "emulators": "npx --yes firebase-tools@15.34.2 emulators:start --only auth,firestore --project demo-flash-cards",
    "deploy": "pnpm run build && npx --yes firebase-tools@15.34.2 deploy --only hosting",
    "deploy:functions": "npx --yes firebase-tools@15.34.2 deploy --only functions",
    "twa:update": "cd android && npx --yes @bubblewrap/cli@1.27.0 update --skipVersionUpgrade",
    "twa:build": "cd android && npx --yes @bubblewrap/cli@1.27.0 build"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "firebase": "^13.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
